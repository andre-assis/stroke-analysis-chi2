total_pessoas_trabalho = count_employment['Private'] + count_employment['Self-employed']
print("\nTotal de pessoas que trabalham como 'private' ou 'Self-employed':", total_pessoas_trabalho)
#### **Filtrando as pessoas de acordo com a respostas, deixando somente as que atendem aos requisitos**
# Filtrando stroke parea receber apenas valores 0 e 1, e work_type para receber apenas Private, ou Self-employed
df_filtered = df[df['stroke'].isin([1, 0]) & df['work_type'].isin(['Private', 'Self-employed'])]
#### **Criando uma tabela de contingência (crosstab) entre as variáveis "stroke" (AVC) e "work_type" (tipo de trabalho).**
ctab = pd.crosstab(df_filtered['stroke'], df_filtered['work_type'])
#### **Mostra a quantidade de pessoas que trabalham de forma 'propria' e tiveram um AVC.**
count_employment = df['work_type'].value_counts()
# Filtrando apenas as categorias 'Private' e 'Self-employed'
filtered_count_employment = count_employment.loc[['Private', 'Self-employed']]

# Criando o DataFrame com a contagem de pessoas por tipo de emprego
df_count_employment = pd.DataFrame(filtered_count_employment, columns=['Quantidade de Pessoas'])

# Adicionando a coluna 'Tipo de Emprego'
df_count_employment['Tipo de Emprego'] = df_count_employment.index

# Reordenando as colunas
df_count_employment = df_count_employment[['Tipo de Emprego', 'Quantidade de Pessoas']]

# Calculando o total de pessoas que trabalham como 'Private' ou 'Self-employed'
total_pessoas_trabalho = count_employment['Private'] + count_employment['Self-employed']

# Obtendo a contagem de pessoas que trabalham de forma 'Self-employed' e tiveram um AVC
self_employed_stroke_count = ctab.loc[1, 'Self-employed']

# Obtendo a contagem de pessoas que trabalham de forma 'Private' e tiveram um AVC
private_stroke_count = ctab.loc[1, 'Private']

# Criando o DataFrame com as informações sobre AVC
data_avc = {'Tipo de Emprego': ['Self-employed', 'Private', 'Total'],
'Quantidade de Pessoas com AVC': [self_employed_stroke_count, private_stroke_count, self_employed_stroke_count + private_stroke_count]}

df_avc = pd.DataFrame(data_avc)

# Exibindo o DataFrame
print("\nInformações sobre AVC:")
print(df_avc)


### **Construção dos Gráficos.**
#### **Mostra Primeiramente em relação total de cada forma de trabalho**
employment_types = ['Private', 'Self-employed']
stroke_counts = [private_stroke_count, self_employed_stroke_count]
total_pessoas_trabalho = count_employment['Private'] + count_employment['Self-employed']

# Calculando a porcentagem de stroke(avc) em realação total_pessoas_trabalho
percentage_stroke_counts = [(count / count_employment[employment_types[i]]) * 100 for i, count in enumerate(stroke_counts)]

# Atribuindo as cores das barras
colors = ['blue', 'green']

# Criando as barra
plt.bar(employment_types, percentage_stroke_counts, color=colors)
plt.xlabel('Tipo de Emprego')
plt.ylabel('Porcentagem de AVC em relação ao tipo de emprego (%)')
plt.title("Porcentagem de AVC em relação ao tipo de emprego")

# Criando as legendas para as barras
legend_labels = ['Private', 'Self-employed']
legend_colors = [plt.Rectangle((0, 0), 1, 1, color=color) for color in colors]
plt.legend(legend_colors, legend_labels)

# Adicionando os labels
for i in range(len(employment_types)):
    plt.text(i, percentage_stroke_counts[i], f"{percentage_stroke_counts[i]:.2f}%", ha='center', va='bottom')

# Exibindo o display
plt.show()

#### **Mostra quantas pessoas tiveram um AVC(stroke) e quantas não tiveram.**
employment_types = ['Private', 'Self-employed']
categories = ['AVC', 'Não AVC']

# Contando os Avc(stroke)
avc_counts = [private_stroke_count, self_employed_stroke_count]

# Calculaando os numeros de não-avc.
non_avc_counts = [count_employment[employment_type] - avc_counts[i] for i, employment_type in enumerate(employment_types)]

# Configuration for grouped bars
bar_width = 0.35
opacity = 0.8

# Positição das barras
index = np.arange(len(employment_types))

# Criando os grupos das barras
fig, ax = plt.subplots()
rects1 = ax.bar(index - bar_width/2, avc_counts, bar_width, alpha=opacity, color='b', label=categories[0])
rects2 = ax.bar(index + bar_width/2, non_avc_counts, bar_width, alpha=opacity, color='g', label=categories[1])

# Configurando os labels e titulos
ax.set_xlabel('Tipo de Emprego')
ax.set_ylabel('Contagem')
ax.set_title('Contagem de AVC e Não AVC por Tipo de Emprego')
ax.set_xticks(index)
ax.set_xticklabels(employment_types)
ax.set_ylim([0, 3000])
ax.legend()

# Acionando o label a barra
def autolabel(rects):
    for rect in rects:
        height = rect.get_height()
        ax.annotate('{}'.format(height),
                    xy=(rect.get_x() + rect.get_width() / 2, height),
                    xytext=(0, 3),
                    textcoords="offset points",
                    ha='center', va='bottom')

autolabel(rects1)
autolabel(rects2)
plt.tight_layout()
plt.show()

### **O teste qui-quadrado de independência usando a tabela de contingência (ctab) criada anteriormente.**
#### **Essa função recebe a tabela de contingência como entrada e retorna vários valores, que são atribuídos às variáveis chi, p, dof e exp.**
##### **chi: O valor do qui-quadrado calculado.**
##### **p: O valor-p associado ao teste qui-quadrado.**
##### **dof: O número de graus de liberdade.**
##### **exp: Uma tabela de contingência esperada sob a hipótese nula de independência.**
##### **Os testes Chi 2 são tendenciosos para cima quando usados ​​em tabelas de contingência 2 x 2. A razão é que a distribuição estatística Chi 2 é contínua e a tabela de contingência 2 x 2 é dicotômica (ou seja, não é contínua, há duas variáveis). Se as frequências de células esperadas estiverem abaixo de 10, você provavelmente deve usar a correção de Yates.**
# Teste feito sem a correção de Yates.
chi, p, dof, exp = stats.chi2_contingency(ctab, correction=False)
# Teste feito com a correção Yates
#chi, p, dof, exp = stats.chi2_contingency(ctab)
#### **Imprime o valor do teste qui-quadrado (chi) e o valor-p (p) calculados a partir do teste qui-quadrado de independência.**
print(chi, p)
#### **Exibe o valor do teste qui-quadrado (chi) formatado.**
print("O valor de de x2 = {}".format(chi))
